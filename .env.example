FLASK_SECRET_KEY=changeme
HEADLESS=true
OUTPUT_EXCEL=scraped_products.xlsx
DATABASE_URL=postgresql+psycopg2://bol_user:bol_password@localhost:5432/bol_scraper
PUBLIC_BASE_URL=http://localhost:5002
# Optioneel:
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

# Ollama (vereist voor AI titels/beschrijvingen)
# Host waar Ollama draait; default is lokaal http://localhost:11434
OLLAMA_HOST=http://localhost:11434
# Modelnaam zoals getoond door `ollama list` (bijv. gemma4-fast:latest, qwen3:32b)
OLLAMA_MODEL=gemma4-fast:latest
