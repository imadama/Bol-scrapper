# Flask configuratie
FLASK_SECRET_KEY=changeme-genereer-random-string
FLASK_DEBUG=0

# Scraper instellingen
HEADLESS=true
OUTPUT_EXCEL=scraped_products.xlsx

# Publieke base URL voor afbeeldingen
# Lokaal: http://localhost:5001
# Productie: https://jouwdomein.nl
PUBLIC_BASE_URL=http://localhost:5001

# Optioneel: Proxy instellingen
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

